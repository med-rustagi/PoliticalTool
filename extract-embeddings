#!/usr/bin/env python3
"""Extract and save CLIP IMAGE embeddings for every post in clean_images.csv.

Setup:  pip3 install torch transformers pillow numpy pandas
Test:   python3 extract_image_embeddings.py --input clean/clean_images.csv --out-dir embeddings/ --limit 50
Full:   python3 extract_image_embeddings.py --input clean/clean_images.csv --out-dir embeddings/

Outputs in --out-dir:
  img_embs.npy         [N, D] float32. Row i = image embedding of post embedding_ids[i]
  embedding_ids.csv    column post_id, same row order as img_embs.npy
  embedding_meta.json  model name, embedding size, counts, device
  skipped.csv          (only if some images failed to open)

Embeddings are L2-normalized by default (standard for CLIP); use --no-normalize to keep raw.
The format matches the text-side output, so text and image work can be combined by post_id.
"""
import argparse
import json
import time
from pathlib import Path

import numpy as np
import pandas as pd
import torch
from PIL import Image
from transformers import CLIPImageProcessor, CLIPModel


def pick_device():
    if torch.cuda.is_available():
        return "cuda"
    mps = getattr(torch.backends, "mps", None)
    if mps is not None and mps.is_available():
        return "mps"  # Apple Silicon Macs
    return "cpu"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--input", required=True, help="clean_images.csv")
    ap.add_argument("--out-dir", default="embeddings")
    ap.add_argument("--model", default="openai/clip-vit-base-patch32")
    ap.add_argument("--batch-size", type=int, default=32)
    ap.add_argument("--limit", type=int, default=None, help="only the first N rows (quick test)")
    ap.add_argument("--no-normalize", action="store_true")
    a = ap.parse_args()

    out = Path(a.out_dir)
    out.mkdir(parents=True, exist_ok=True)

    df = pd.read_csv(a.input, dtype={"post_id": str})
    if a.limit:
        df = df.head(a.limit)
    device = pick_device()
    print("Rows: %d | device: %s | model: %s" % (len(df), device, a.model))

    model = CLIPModel.from_pretrained(a.model).to(device).eval()
    proc = CLIPImageProcessor.from_pretrained(a.model)

    ids, chunks, skipped = [], [], []
    t0 = time.time()
    with torch.no_grad():
        for start in range(0, len(df), a.batch_size):
            batch = df.iloc[start:start + a.batch_size]
            imgs, bids = [], []
            for pid, path in zip(batch["post_id"], batch["image_path"]):
                try:
                    with Image.open(path) as im:
                        imgs.append(im.convert("RGB"))
                    bids.append(pid)
                except Exception as e:
                    skipped.append({"post_id": pid, "error": type(e).__name__})
            if not bids:
                continue
            pixel_values = proc(images=imgs, return_tensors="pt")["pixel_values"].to(device)
            feats = model.get_image_features(pixel_values=pixel_values)
            if not a.no_normalize:
                feats = feats / feats.norm(dim=-1, keepdim=True)
            chunks.append(feats.float().cpu().numpy())
            ids.extend(bids)
            print("  %d/%d rows (%.0fs)" % (start + len(batch), len(df), time.time() - t0), flush=True)

    if not ids:
        raise SystemExit("No embeddings were produced. Check the image_path column in your input file.")

    E = np.concatenate(chunks).astype(np.float32)
    assert len(ids) == len(E)
    np.save(out / "img_embs.npy", E)
    pd.DataFrame({"post_id": ids}).to_csv(out / "embedding_ids.csv", index=False)
    if skipped:
        pd.DataFrame(skipped).to_csv(out / "skipped.csv", index=False)
    meta = {"model": a.model, "dim": int(E.shape[1]), "n_embedded": len(ids),
            "n_skipped": len(skipped), "normalized": not a.no_normalize, "device": device}
    (out / "embedding_meta.json").write_text(json.dumps(meta, indent=2))
    print("\nDone.", json.dumps(meta, indent=2))


if __name__ == "__main__":
    main()
